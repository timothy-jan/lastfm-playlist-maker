# Last.fm — https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Web app callback (also add this URI in your Spotify app settings)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback
# Optional: set when hosting elsewhere (Render sets RENDER_EXTERNAL_URL automatically)
# APP_URL=https://your-app.onrender.com

# Flask session secret (change in production)
FLASK_SECRET_KEY=change-me-to-a-random-string
